# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: higher GitHub rate limits and private repos (read-only token is enough)
GITHUB_TOKEN=

# Optional overrides
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high            # low | medium | high | xhigh | max
MAX_DIFF_CHARS=150000        # larger diffs are rejected, never silently truncated
MAX_CONCURRENT_REVIEWS=3
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_review
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_review_test   # used only by pytest
LOG_LEVEL=INFO
